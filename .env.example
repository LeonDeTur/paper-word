# Local: npm run dev. The local server without APP_PASSWORD binds only to 127.0.0.1.
PORT=3001
HOST=127.0.0.1
DB_PATH=data/paperword.sqlite

# Required for VPS deployment. Use a unique password of at least 12 characters.
APP_PASSWORD=
APP_ORIGIN=
APP_DOMAIN=
# VPS example: APP_ORIGIN=https://papers.example.com, APP_DOMAIN=papers.example.com

# OpenAI-compatible API; the base address must end in /v1.
# Local Ollama example. In Docker, localhost points to the app container.
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_MODEL=
AI_API_KEY=
