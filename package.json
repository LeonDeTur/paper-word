{
  "name": "paperword",
  "private": true,
  "version": "0.2.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=build/server.mjs && esbuild server/mcp-stdio.ts --bundle --platform=node --format=esm --packages=external --outfile=build/mcp-stdio.mjs",
    "start": "node build/server.mjs",
    "mcp:stdio": "node build/mcp-stdio.mjs",
    "test": "node scripts/test.mjs all",
    "test:unit": "node scripts/test.mjs unit",
    "test:integration": "node scripts/test.mjs integration",
    "test:tooling": "node scripts/test.mjs tooling",
    "test:coverage": "node scripts/test.mjs all --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src server tests scripts *.ts *.mjs",
    "format:check": "prettier --check .",
    "check:versions": "node scripts/check-versions.mjs",
    "check:privacy": "node scripts/repository-policy.mjs",
    "check": "npm run check:versions && npm run check:privacy && npm run format:check && npm run lint && npm run build && npm test",
    "check:all": "npm run check && npm run test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "format": "prettier --write .",
    "setup": "node scripts/setup.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "commitlint": "commitlint",
    "release": "node scripts/release.mjs",
    "release:pack": "node scripts/package-release.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "cheerio": "^1.2.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.61.0",
    "multer": "^2.5.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "commit-and-tag-version": "^13.3.0",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
